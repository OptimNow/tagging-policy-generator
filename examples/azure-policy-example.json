  "contentVersion": "1.0.0.0",
  "metadata": {
    "generatedBy": "OptimNow Tagging Policy Generator",
    "policyVersion": "1.0",
    "deploymentScope": "subscription",
    "cliExample": "az deployment sub create --location <region> --template-file azure_tagging_bundle.json"
